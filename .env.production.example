# Variables Vercel / production — ne pas commiter de secrets réels

NODE_ENV=production

DATABASE_POOLER_URL=postgresql://postgres.PROJECT:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require

# Clé JWT aléatoire (≥ 32 caractères) — jamais la valeur de développement
JWT_SECRET=

# Numéros admin (serveur uniquement, jamais affichés dans l’UI)
ADMIN_PHONES=+228XXXXXXXX

NEXT_PUBLIC_APP_URL=https://votre-domaine.vercel.app
APP_BASE_URL=https://votre-domaine.vercel.app
CORS_ORIGIN=https://votre-domaine.vercel.app

# Paiements réels
FEDAPAY_ENVIRONMENT=live
FEDAPAY_SECRET_KEY=
FEDAPAY_PUBLIC_KEY=
FEDAPAY_WEBHOOK_SECRET=
FEDAPAY_CALLBACK_URL=https://votre-domaine.vercel.app/transactions

# À NE PAS activer en production :
# ALLOW_SIMULATE_PAYMENT=true
# SEED_DEMO_ON_START=true
# USE_FIXED_OTP=true
# EXPOSE_OTP_IN_RESPONSE=true
